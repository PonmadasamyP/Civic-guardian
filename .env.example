# ========================================================================
# CIVIC GUARDIAN - Environment Variables
# ========================================================================
# Supabase Configuration
# 1. Create a free project at https://supabase.com
# 2. Go to Project Settings -> API
# 3. Copy "Project URL" into VITE_SUPABASE_URL
# 4. Copy "anon public key" into VITE_SUPABASE_ANON_KEY
# 5. Execute schema.sql in Supabase SQL Editor
# ========================================================================

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Optional: Leaflet Map Tile Provider (OpenStreetMap by default)
VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors
